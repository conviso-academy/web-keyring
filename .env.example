# === Banco de Dados ===
POSTGRES_USER=webkeyring
POSTGRES_PASSWORD=<gerar_senha_forte>
POSTGRES_DB=webkeyring
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# === Criptografia ===
ENCRYPTION_KEY=<chave_AES-256_base64_32bytes>

# === Sessões ===
SECRET_KEY=<chave_assinatura_cookies>
SESSION_MAX_AGE_HOURS=6

# === Argon2id ===
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# === Ambiente ===
ENVIRONMENT=development
DEBUG=true

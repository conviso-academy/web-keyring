# === Banco de Dados ===
POSTGRES_USER=webkeyring
POSTGRES_PASSWORD=<gerar_senha_forte>
POSTGRES_DB=webkeyring
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# === Criptografia ===
ENCRYPTION_KEY=<chave_AES-256_base64_32bytes>

# === Sessões ===
SECRET_KEY=<chave_assinatura_cookies>
SESSION_MAX_AGE_HOURS=6

# === Argon2id ===
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# === Ambiente ===
ENVIRONMENT=development
DEBUG=true

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:5173

# === Rate Limiting ===
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_2FA=5/minute

# === Bloqueio de Conta ===
MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# === TOTP ===
TOTP_ISSUER=Web-Keyring
TOTP_DIGITS=6
TOTP_INTERVAL=30

# === Token Temporário de 2FA ===
TWO_FA_TOKEN_TTL_MINUTES=5
